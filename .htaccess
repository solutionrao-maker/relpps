Options -Indexes
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>

# Impede acesso direto ao config.php pelo navegador
<Files "config.php">
    Require all denied
</Files>

# Bloqueia a pasta tests/ (ferramenta de desenvolvimento local — nunca deve ser servida,
# mesmo que enviada acidentalmente pro servidor). Reforçado também por tests/.htaccess.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tests/ - [F,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>
